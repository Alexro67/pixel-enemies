rules_version = '2';
// Reglas de seguridad de la base de datos de Pixel Enemies.
// Se copian y pegan en Firebase > Firestore Database > Reglas.
service cloud.firestore {
  match /databases/{db}/documents {
    // Partidas: las ve cualquiera que tenga el código; las cambian solo sus jugadores
    // (o alguien que se une mientras la partida está en la sala de espera).
    match /partidas/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid
        && request.resource.data.uids == [request.auth.uid];
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.uids ||
        (resource.data.status == 'sala' && request.auth.uid in request.resource.data.uids
          && request.resource.data.uids.size() <= 6));
      // Turnos jugados (para ver la repetición). No se pueden cambiar después.
      match /turnos/{n} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(db)/documents/partidas/$(code)).data.uids;
      }
    }
    // Dirección de avisos de cada móvil: solo la escribe su dueño y nadie la lee
    // (la lee GitHub con su llave especial, que se salta estas reglas).
    match /avisos/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Llave pública de los avisos (la pone GitHub).
    match /config/{doc} {
      allow read: if true;
    }
  }
}
